        <mxCell id="sgI8TpdLQj7p2PicKRae-39" edge="1" parent="1" source="sgI8TpdLQj7p2PicKRae-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;fontColor=#FFB570;fillColor=#ffe6cc;strokeColor=#d79b00;" target="sgI8TpdLQj7p2PicKRae-32" value="订阅">
