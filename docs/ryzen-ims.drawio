        <mxCell id="sgI8TpdLQj7p2PicKRae-36" parent="1" style="swimlane;startSize=0;" value="聚合聊天服务" vertex="1">
          <mxGeometry height="204" width="200" x="1248" y="1062" as="geometry" />
