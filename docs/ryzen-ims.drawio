        <mxCell id="AVvflabqGcv-pRj6uG-Y-4" parent="sgI8TpdLQj7p2PicKRae-36" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="message" vertex="1">
