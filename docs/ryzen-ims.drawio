        <mxCell id="sgI8TpdLQj7p2PicKRae-36" parent="1" style="swimlane;startSize=0;" value="聚合聊天服务" vertex="1">
          <mxGeometry height="198" width="200" x="1284" y="982.99" as="geometry" />
        </mxCell>
        <mxCell id="evLPilckgvB3638-_uI4-3" parent="sgI8TpdLQj7p2PicKRae-36" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="会话调度" vertex="1">
