        <mxCell id="_EIIrl3uh-dSRCNPObY--27" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ExecutorStatus&lt;/h1&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;OFFLINE,       // 离线&lt;br&gt;WAIT_LOGIN,    // 等待登录&lt;br&gt;READY,         // 已登录，空闲&lt;br&gt;BUSY,          // 正在执行任务&lt;br&gt;  COLLECTING   // 采集中&lt;br&gt;  SENDING      // 发送中&lt;br&gt;ERROR          // 执行异常&lt;/code&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="163" width="244" x="677" y="1987" as="geometry" />
        </mxCell>
        <mxCell id="_EIIrl3uh-dSRCNPObY--28" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Executor&lt;/h1&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;登录成功：注册。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;每隔10秒：发送心跳。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;执行任务：报告 BUSY。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;完成任务：报告 READY。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;登录失效：报告 WAIT_LOGIN。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;发生异常：报告 ERROR。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="216" width="256" x="421" y="1987" as="geometry" />
        </mxCell>
        <mxCell id="_EIIrl3uh-dSRCNPObY--30" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Topic&lt;/h1&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;p&gt;&lt;code&gt;chat.executor.register &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;执行器 → 调度器&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;注册&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;chat.executor.heartbeat&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;执行器 → 调度器&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;心跳、状态&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;chat.executor.task&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;调度器 → 执行器&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;执行任务&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;chat.executor.result&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;执行器 → 调度器&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;任务执行结果&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;code&gt;chat.executor.message&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;执行器 → 调度器&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;采集到的聊天消息&lt;/span&gt;&lt;/p&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="190" width="476" x="445" y="2417" as="geometry" />
        </mxCell>
